rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidCompanyProfile(data, userId) {
      return data.keys().hasAll([
               'userId',
               'companyName',
               'developerCredit',
               'currencySymbol',
               'defaultTaxRate',
               'nextBillNumber',
               'nextQuotationNumber',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'companyName',
               'developerCredit',
               'tagline',
               'phone',
               'email',
               'address',
               'taxNumber',
               'currencySymbol',
               'defaultTaxRate',
               'defaultTerms',
               'signatoryName',
               'nextBillNumber',
               'nextQuotationNumber',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 100 &&
             data.developerCredit is string && data.developerCredit.size() >= 1 && data.developerCredit.size() <= 120 &&
             isValidOptionalString(data, 'tagline', 120) &&
             isValidOptionalString(data, 'phone', 40) &&
             isValidOptionalString(data, 'email', 120) &&
             isValidOptionalString(data, 'address', 300) &&
             isValidOptionalString(data, 'taxNumber', 60) &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8 &&
             data.defaultTaxRate is number && data.defaultTaxRate >= 0 && data.defaultTaxRate <= 100 &&
             isValidOptionalString(data, 'defaultTerms', 500) &&
             isValidOptionalString(data, 'signatoryName', 100) &&
             data.nextBillNumber is int && data.nextBillNumber >= 1 && data.nextBillNumber <= 9999999 &&
             data.nextQuotationNumber is int && data.nextQuotationNumber >= 1 && data.nextQuotationNumber <= 9999999 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCustomer(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'userId',
               'name',
               'phone',
               'email',
               'address',
               'taxNumber',
               'notes',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             isValidOptionalString(data, 'phone', 40) &&
             isValidOptionalString(data, 'email', 120) &&
             isValidOptionalString(data, 'address', 300) &&
             isValidOptionalString(data, 'taxNumber', 60) &&
             isValidOptionalString(data, 'notes', 500) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBillingDocument(data, userId) {
      return data.keys().hasAll([
               'userId',
               'docType',
               'docNumber',
               'status',
               'customerName',
               'issueDate',
               'currencySymbol',
               'items',
               'subtotal',
               'discountPercent',
               'discountAmount',
               'taxRate',
               'taxAmount',
               'grandTotal',
               'developerCredit',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'docType',
               'docNumber',
               'status',
               'customerId',
               'customerName',
               'customerPhone',
               'customerEmail',
               'customerAddress',
               'customerTaxNumber',
               'issueDate',
               'dueDate',
               'currencySymbol',
               'items',
               'subtotal',
               'discountPercent',
               'discountAmount',
               'taxRate',
               'taxAmount',
               'grandTotal',
               'notes',
               'developerCredit',
               'convertedToBillId',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.docType is string && data.docType in ['BILL', 'QUOTATION'] &&
             data.docNumber is string && data.docNumber.size() >= 1 && data.docNumber.size() <= 50 &&
             data.status is string && (
               (data.docType == 'BILL' && data.status in ['UNPAID', 'PARTIAL', 'PAID']) ||
               (data.docType == 'QUOTATION' && data.status in ['DRAFT', 'SENT', 'APPROVED', 'CONVERTED'])
             ) &&
             isValidOptionalString(data, 'customerId', 128) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
             isValidOptionalString(data, 'customerPhone', 40) &&
             isValidOptionalString(data, 'customerEmail', 120) &&
             isValidOptionalString(data, 'customerAddress', 300) &&
             isValidOptionalString(data, 'customerTaxNumber', 60) &&
             data.issueDate is string && data.issueDate.size() >= 1 && data.issueDate.size() <= 30 &&
             isValidOptionalString(data, 'dueDate', 30) &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
             data.items[0] is map &&
             data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 1000000000 &&
             data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100 &&
             data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 1000000000 &&
             data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
             data.taxAmount is number && data.taxAmount >= 0 && data.taxAmount <= 1000000000 &&
             data.grandTotal is number && data.grandTotal >= 0 && data.grandTotal <= 1000000000 &&
             isValidOptionalString(data, 'notes', 1000) &&
             data.developerCredit is string && data.developerCredit.size() >= 1 && data.developerCredit.size() <= 120 &&
             isValidOptionalString(data, 'convertedToBillId', 128) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidCompanyProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidCompanyProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action: Update business profile details
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'companyName', 'developerCredit', 'tagline', 'phone', 'email',
                           'address', 'taxNumber', 'currencySymbol', 'defaultTaxRate',
                           'defaultTerms', 'signatoryName', 'updatedAt'
                         ]) ||
                         // Action: Increment bill or quotation sequence counters
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'nextBillNumber', 'nextQuotationNumber', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'nextBillNumber', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'nextQuotationNumber', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /customers/{customerId} {
        allow get: if isOwner(userId) && isValidId(customerId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           // Action: Edit customer profile
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'phone', 'email', 'address', 'taxNumber', 'notes', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(customerId);
      }

      match /documents/{documentId} {
        allow get: if isOwner(userId) && isValidId(documentId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(documentId) &&
                         isValidBillingDocument(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(documentId) &&
                         isValidBillingDocument(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().docType == existing().docType &&
                         incoming().createdAt == existing().createdAt &&
                         // Terminal state locking: PAID bills and CONVERTED quotations cannot be modified
                         !(existing().status in ['PAID', 'CONVERTED']) && (
                           // Action: Edit draft/unpaid document details and items
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'docNumber', 'status', 'customerId', 'customerName', 'customerPhone',
                             'customerEmail', 'customerAddress', 'customerTaxNumber',
                             'issueDate', 'dueDate', 'currencySymbol', 'items',
                             'subtotal', 'discountPercent', 'discountAmount',
                             'taxRate', 'taxAmount', 'grandTotal', 'notes',
                             'developerCredit', 'updatedAt'
                           ]) ||
                           // Action: Status transition (e.g., mark PAID / SENT / APPROVED)
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'status', 'updatedAt'
                           ]) ||
                           // Action: Convert quotation to bill
                           (existing().docType == 'QUOTATION' &&
                            incoming().status == 'CONVERTED' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'convertedToBillId', 'updatedAt'
                            ]))
                         );

        allow delete: if isOwner(userId) && isValidId(documentId);
      }
    }
  }
}
